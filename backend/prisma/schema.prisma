generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String?
  pictureUrl           String?
  role                 Role                 @default(STUDENT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  password             String?
  department           String?
  reg_no               String?              @unique
  section              String?
  year                 Int?
  settings             Json?
  leetcodeId           String?
  leetcodeStats        Json?
  pictureData          Bytes?
  pictureMimeType      String?
  points               Int                  @default(0)
  attempts             Attempt[]
  dynamicSessions      DynamicExamSession[]
  assessments          Evaluation[]         @relation("EvaluationAssessor")
  createdTemplates     ExamTemplate[]
  notifications        Notification[]
  pointsHistory        PointsHistory[]
  invalidatedQuestions Question[]           @relation("QuestionInvalidator")
  reportedQuestions    QuestionReport[]
  redeemOrders         RedeemOrder[]

  @@index([role])
  @@index([year, department, section])
}

model Exam {
  id                   String               @id @default(cuid())
  title                String
  description          String?
  startAt              DateTime
  endAt                DateTime
  timingMode           TimingMode           @default(OVERALL_ONLY)
  durationMins         Int
  sectionLockPolicy    SectionLockPolicy    @default(NONE)
  randomizeQuestions   Boolean              @default(false)
  negativeMarkPerWrong Decimal?             @db.Decimal(5, 2)
  status               ExamStatus           @default(DRAFT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  maxAttempts          Int?
  allowedLanguages     Json?
  maxTabSwitches       Int?
  releaseResults       Boolean              @default(true)
  enableProctoring     Boolean              @default(false)
  mode                 ExamMode             @default(STANDARD)
  dynamicQuestionCount Int?                 @default(5)
  generationPrompt     String?
  dynamicTopics        String[]
  attempts             Attempt[]
  dynamicSessions      DynamicExamSession[]
  assignments          ExamAssignment[]
  sections             ExamSection[]
  questions            Question[]
  questionPool         QuestionPool[]
  reports              QuestionReport[]

  @@index([status])
  @@index([startAt, endAt])
}

model ExamAssignment {
  id               String  @id @default(uuid())
  examId           String
  cohortYear       Int?
  cohortDepartment String?
  cohortSection    String?
  studentIds       Json?
  assignToAll      Boolean @default(false)
  exam             Exam    @relation(fields: [examId], references: [id])

  @@index([examId])
  @@index([cohortYear, cohortDepartment, cohortSection])
}

model ExamSection {
  id               String            @id @default(cuid())
  examId           String
  title            String
  order            Int
  description      String?
  durationMins     Int?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         AttemptSection[]
  exam             Exam              @relation(fields: [examId], references: [id])
  sectionQuestions SectionQuestion[]

  @@index([examId])
  @@index([order])
}

model SectionQuestion {
  id         String      @id @default(cuid())
  sectionId  String
  questionId String
  order      Int
  question   Question    @relation(fields: [questionId], references: [id])
  section    ExamSection @relation(fields: [sectionId], references: [id])

  @@unique([sectionId, questionId])
  @@index([questionId])
}

model Question {
  id                 String            @id @default(cuid())
  examId             String?
  order              Int
  type               QType
  points             Decimal           @db.Decimal(6, 2)
  difficulty         Difficulty        @default(MEDIUM)
  prompt             String?
  options            Json?
  correctOptionIds   Json?
  starterCode        String?
  testcases          Json?
  languageHints      Json?
  wordLimit          Int?
  mediaAssetId       String?
  passageAssetId     String?
  maxDurationSec     Int?
  clozeTemplate      String?
  blanks             Json?
  clozeConfig        Json?
  config             Json?
  rubricId           String?
  status             QuestionStatus    @default(ACTIVE)
  invalidationReason String?
  invalidatedAt      DateTime?
  invalidatedById    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  language           String?
  exam               Exam?             @relation(fields: [examId], references: [id])
  invalidatedBy      User?             @relation("QuestionInvalidator", fields: [invalidatedById], references: [id])
  mediaAsset         Asset?            @relation("Question_mediaAsset", fields: [mediaAssetId], references: [id])
  passageAsset       Asset?            @relation("Question_passageAsset", fields: [passageAssetId], references: [id])
  rubric             Rubric?           @relation("QuestionRubric", fields: [rubricId], references: [id])
  reports            QuestionReport[]
  responses          Response[]
  sectionLinks       SectionQuestion[]

  @@index([examId])
  @@index([type])
  @@index([status])
}

model Attempt {
  id                     String            @id @default(cuid())
  examId                 String
  studentId              String
  attemptNo              Int               @default(1)
  startedAt              DateTime          @default(now())
  submittedAt            DateTime?
  status                 AttemptStatus     @default(IN_PROGRESS)
  score                  Decimal?          @db.Decimal(8, 2)
  maxScore               Decimal?          @db.Decimal(8, 2)
  timeSpentSec           Int               @default(0)
  orderMap               Json?
  submissionReason       String?
  submissionType         SubmissionType    @default(NORMAL)
  eyeTrackingViolations  Int               @default(0)
  headTrackingViolations Int               @default(0)
  exam                   Exam              @relation(fields: [examId], references: [id])
  student                User              @relation(fields: [studentId], references: [id])
  sections               AttemptSection[]
  proctoringEvents       ProctoringEvent[]
  responses              Response[]

  @@unique([examId, studentId, attemptNo])
  @@index([examId])
  @@index([studentId])
  @@index([startedAt])
  @@index([score])
}

model ProctoringEvent {
  id          String              @id @default(cuid())
  attemptId   String
  eventType   ProctoringEventType
  severity    String              @default("warning")
  description String?
  timestamp   DateTime            @default(now())
  metadata    Json?
  attempt     Attempt             @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([eventType])
  @@index([timestamp])
}

model AttemptSection {
  id           String               @id @default(cuid())
  attemptId    String
  sectionId    String
  status       SectionAttemptStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  timeSpentSec Int                  @default(0)
  remainingSec Int?
  lockReason   String?
  attempt      Attempt              @relation(fields: [attemptId], references: [id])
  section      ExamSection          @relation(fields: [sectionId], references: [id])

  @@unique([attemptId, sectionId])
  @@index([attemptId])
  @@index([sectionId])
}

model Response {
  id               String             @id @default(cuid())
  attemptId        String
  questionId       String
  type             QType
  answer           Json?
  chosenOptionIds  Json?
  code             String?
  language         String?
  textAnswer       String?
  audioAssetId     String?
  gradingMode      GradingMode?
  verdict          String?
  earnedPoints     Decimal?           @db.Decimal(6, 2)
  manualAdjustment Decimal?           @db.Decimal(6, 2)
  feedback         String?
  judgeRunId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  evaluations      Evaluation[]
  gradingJobs      GradingJob[]
  attempt          Attempt            @relation(fields: [attemptId], references: [id])
  audioAsset       Asset?             @relation("Response_audioAsset", fields: [audioAssetId], references: [id])
  question         Question           @relation(fields: [questionId], references: [id])
  artifacts        ResponseArtifact[]

  @@unique([attemptId, questionId])
  @@index([attemptId, questionId])
  @@index([type])
}

model Evaluation {
  id         String         @id @default(cuid())
  responseId String
  kind       EvaluationKind
  assessorId String?
  rubricId   String?
  score      Decimal?       @db.Decimal(6, 2)
  breakdown  Json?
  complexity Json?
  comments   String?
  isFinal    Boolean        @default(false)
  createdAt  DateTime       @default(now())
  assessor   User?          @relation("EvaluationAssessor", fields: [assessorId], references: [id])
  response   Response       @relation(fields: [responseId], references: [id])
  rubric     Rubric?        @relation("EvaluationRubric", fields: [rubricId], references: [id])

  @@index([responseId])
  @@index([kind])
  @@index([assessorId])
}

model Rubric {
  id          String       @id @default(cuid())
  name        String
  criteria    Json
  createdBy   String?
  createdAt   DateTime     @default(now())
  evaluations Evaluation[] @relation("EvaluationRubric")
  questions   Question[]   @relation("QuestionRubric")
}

model Asset {
  id                  String             @id @default(cuid())
  kind                AssetKind
  url                 String
  durationSec         Int?
  meta                Json?
  createdAt           DateTime           @default(now())
  mediaForQuestions   Question[]         @relation("Question_mediaAsset")
  passageForQuestions Question[]         @relation("Question_passageAsset")
  responseAudioFor    Response[]         @relation("Response_audioAsset")
  artifacts           ResponseArtifact[]
}

model ResponseArtifact {
  id         String   @id @default(cuid())
  responseId String
  assetId    String
  createdAt  DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id])
  response   Response @relation(fields: [responseId], references: [id])

  @@index([responseId])
  @@index([assetId])
}

model GradingJob {
  id         String   @id @default(cuid())
  responseId String
  provider   String
  status     String   @default("QUEUED")
  payload    Json?
  result     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  response   Response @relation(fields: [responseId], references: [id])

  @@index([responseId])
  @@index([status, createdAt])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  tokenId   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExamTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  structure   Json
  isPublic    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [createdBy], references: [id])

  @@index([isPublic])
  @@index([createdBy])
}

model QuestionReport {
  id          String       @id @default(cuid())
  questionId  String
  studentId   String
  examId      String
  description String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  exam        Exam         @relation(fields: [examId], references: [id])
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id])

  @@index([questionId])
  @@index([examId])
  @@index([status])
}

model RedeemItem {
  id          String        @id @default(cuid())
  name        String
  description String?
  pointsCost  Int
  isActive    Boolean       @default(true)
  itemType    String
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orders      RedeemOrder[]

  @@index([isActive])
  @@index([itemType])
}

model RedeemOrder {
  id              String            @id @default(cuid())
  userId          String
  itemId          String
  pointsCost      Int
  status          RedeemOrderStatus @default(PENDING)
  adminNotes      String?
  rejectionReason String?
  reportUrl       String?
  processedById   String?
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  leaveDate       DateTime?
  message         String?
  item            RedeemItem        @relation(fields: [itemId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([itemId])
}

model PointsHistory {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  balance     Int
  type        String
  description String?
  relatedId   String?
  relatedType String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model QuestionPool {
  id         String     @id @default(cuid())
  topic      String
  difficulty Difficulty
  data       Json
  isUsed     Boolean    @default(false)
  examId     String?
  createdAt  DateTime   @default(now())
  exam       Exam?      @relation(fields: [examId], references: [id])

  @@index([topic, difficulty])
  @@index([examId])
  @@index([isUsed])
}

model DynamicExamSession {
  id                String     @id @default(cuid())
  studentId         String
  examId            String
  currentDifficulty Difficulty @default(MEDIUM)
  questionsAnswered Int        @default(0)
  history           Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  exam              Exam       @relation(fields: [examId], references: [id])
  student           User       @relation(fields: [studentId], references: [id])

  @@unique([studentId, examId])
  @@index([examId])
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum QType {
  MCQ
  CODING
  ESSAY
  SPEAKING
  LISTENING
  FILL
  READING
  SQL
}

enum GradingMode {
  AUTO
  MANUAL
  AI
  HYBRID
}

enum EvaluationKind {
  MANUAL
  AI
}

enum AssetKind {
  AUDIO
  VIDEO
  IMAGE
  FILE
  TEXT
}

enum QuestionStatus {
  ACTIVE
  INVALIDATED
}

enum ReportStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum RedeemOrderStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TimingMode {
  OVERALL_ONLY
  PER_SECTION_ONLY
  BOTH
}

enum SectionLockPolicy {
  NONE
  LOCK_ON_COMPLETE
  LINEAR_NO_BACKTRACK
}

enum ProctoringEventType {
  EYE_TRACKING_VIOLATION
  HEAD_TRACKING_VIOLATION
  FACE_NOT_DETECTED
  MULTIPLE_FACES_DETECTED
  LOOKING_AWAY
  HEAD_TURNED_AWAY
  EYES_CLOSED
  SUSPICIOUS_MOVEMENT
}

enum SectionAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  LOCKED
}

enum SubmissionType {
  NORMAL
  AUTO
}

enum ExamMode {
  STANDARD
  DYNAMIC
}

enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
}
