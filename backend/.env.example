# ============================================================
# Backend API Server Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Server
PORT=4000
NODE_ENV=production

# Database (PostgreSQL)
# For local PostgreSQL (production recommended):
USE_SUPABASE=false
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shadowcoders?schema=public
# For Supabase:
# USE_SUPABASE=true
# DATABASE_URL=postgresql://...supabase-connection-string...
# DIRECT_URL=postgresql://...supabase-direct-url...

# Redis (required for BullMQ job queue)
REDIS_URL=redis://127.0.0.1:6379

# Authentication
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# CORS
FRONTEND_ORIGIN=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:3000
# ALLOW_ALL_ORIGINS=false  # Never true in production

# Code Execution
MAX_CONCURRENT_EXECUTIONS=3
MAX_QUEUE_SIZE=500
EXECUTION_OS=linux

# AI Grading
AI_PROVIDER=gemini
GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# File Uploads
# UPLOADS_DIR=/var/shadowcoders/uploads
