FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install compilers and runtimes for C, C++, Java, Python
# Minimized package list — no pip, no nodejs (not needed for contest)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    default-jdk-headless \
    python3 \
    coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Remove dangerous binaries that students don't need
RUN rm -f /usr/bin/wget /usr/bin/curl /usr/bin/nc /usr/bin/ncat \
    /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg \
    /usr/bin/ssh /usr/bin/scp /usr/bin/sftp \
    2>/dev/null || true

# Create non-root user for sandboxed execution
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/sh sandbox

# Create working directory
RUN mkdir -p /sandbox && chown sandbox:sandbox /sandbox

# Set resource limits in profile
RUN echo "ulimit -f 8192" >> /home/sandbox/.profile && \
    echo "ulimit -v 262144" >> /home/sandbox/.profile && \
    echo "ulimit -t 10" >> /home/sandbox/.profile

# Default working directory
WORKDIR /sandbox

# Run as non-root by default
USER sandbox

# No CMD — always overridden by docker run
