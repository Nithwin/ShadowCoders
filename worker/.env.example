# ============================================================
# Worker Service Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Redis connection (must match the API server's Redis)
REDIS_URL=redis://127.0.0.1:6379
# If worker runs on Server 2, point to Server 1's Redis:
# REDIS_URL=redis://<SERVER1_IP>:6379

# Docker sandbox image name (must be pre-built on this machine)
DOCKER_IMAGE=shadowcoders-sandbox:latest

# Number of concurrent job processors per worker instance
# Recommendation: 1 per CPU core available for workers
WORKER_CONCURRENCY=1

# Health check HTTP port (PM2 auto-increments via instance_var)
HEALTH_PORT=9100

# Code execution timeout (ms) — safety ceiling
EXECUTION_TIMEOUT_MS=15000

# Temp directory for code files mounted into Docker
TEMP_DIR=/tmp/shadowcoders

NODE_ENV=production
